.env
data/
.venv/
__pycache__/
*.pyc
*.db
*.db-wal
*.db-shm
.pytest_cache/

# ---- 2026-11-13 开源/简历化：以下内容绝不入库 ----
.venv2/
*.log
# 本机配置（含绝对路径与账号名）：只提交 config.example.yaml
config.yaml
# 运行产物
data/*.db
data/*.json
data/*.jsonl
pacer_state*.json
probe_budget.json
supervise.log
# 浏览器资料（含 cookie / session，绝不能提交）
chrome-boss*/
.boss-agent*/
# ---- 2026-11-13 发布：以下同样绝不入库 ----
# 打包产物：53MB 二进制，CI 会重新生成；进仓库后每次 clone 都要拖一遍
dist/
build/
# 历史配置备份：里面有本机绝对路径（C:\Users\<用户名>\...）
config.yaml.bak-*
*.bak-*
# PyInstaller / Inno 的中间产物
*.spec.bak

# ---- 2026-11-16 Android 侧：签名与本地路径，绝不能被 git add -A 带上去 ----
# local.properties 里有 sdk.dir=C:\Users\<你的用户名>\AppData\Local\Android\Sdk，
# 是最容易被“顺手提交”的一个文件（Android Studio 自动生成，很多人以为它是源码）。
android/local.properties
local.properties
# 签名文件：仓库里一旦出现 keystore，等于把发布权限公开
*.jks
*.keystore
*.p12
# Gradle 缓存与构建产物（build/ 的通用规则在上面，这里补 .gradle 与产物）
android/.gradle/
.gradle/
*.apk
*.aab
# IDE 与调试抓取
.idea/
captures/


