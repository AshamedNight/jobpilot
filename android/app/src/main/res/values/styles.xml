<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar：标题栏由布局自己画，省掉一条灰条，观感立刻不一样 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="BtnPrimary">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="BtnGhost">
        <item name="android:background">@drawable/bg_ghost</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
