<?xml version="1.0" encoding="utf-8"?>
<!-- 图标前景：一支指向右上角的箭头（= 自动推进）。
     用矢量而不是 PNG：不用为每个 dpi 出图，也不会因为漏了某个尺寸在某些机型上糊。
     自适应图标的内容安全区是中间 72x72（viewport 108x108），所以图形都画在 30..78 之间。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M38,72 L70,40"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M70,40 L70,62"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M70,40 L48,40"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round" />
</vector>
